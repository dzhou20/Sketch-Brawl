[2m2025-11-15T09:08:55.268329Z[0m [32m INFO[0m ToolCall: shell {"command":["bash","-lc","cat <<'EOF' > backend/src/services/telemetry.py\n\"\"\"Telemetry aggregation service.\"\"\"\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom datetime import datetime\nfrom typing import Any\n\nimport redis\n\nfrom api.main import get_settings\n\n\n@dataclass\nclass TelemetryEvent:\n    session_id: str\n    source: str\n    event_type: str\n    payload: dict[str, Any]\n    captured_at: datetime\n\n\nclass TelemetryService:\n    def __init__(self) -> None:\n        self._redis = redis.from_url(get_settings().redis_url)\n\n    def publish(self, event: TelemetryEvent) -> None:\n        channel = f\"telemetry:{event.event_type}\"\n        self._redis.xadd(\n            channel,\n            {\n                \"session\": event.session_id,\n                \"source\": event.source,\n                \"captured_at\": event.captured_at.isoformat(),\n                \"payload\": event.payload,\n            },\n        )\n\n    def aggregate_latency(self, session_id: str) -> dict[str, float]:\n        channel = \"telemetry:canvas_latency\"\n        entries = self._redis.xrange(channel, count=100)\n        samples = [float(entry[1][b\"payload\"].decode()) for entry in entries if entry[1].get(b\"session\") == session_id.encode()]\n        if not samples:\n            return {\"p95\": 0.0, \"min_fps\": 0.0}\n        samples.sort()\n        idx = int(len(samples) * 0.95) - 1\n        return {\"p95\": samples[max(idx, 0)], \"min_fps\": min(samples)}\n\n\n_service: TelemetryService | None = None\n\n\ndef get_telemetry_service() -> TelemetryService:\n    global _service\n    if _service is None:\n        _service = TelemetryService()\n    return _service\nEOF"]}
