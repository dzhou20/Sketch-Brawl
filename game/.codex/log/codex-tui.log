[2m2025-11-15T09:08:45.394061Z[0m [32m INFO[0m ToolCall: shell {"command":["bash","-lc","cat <<'EOF' > backend/src/services/inference_runner.py\n\"\"\"ONNX-based inference runner with deterministic seeds.\"\"\"\nfrom __future__ import annotations\n\nfrom pathlib import Path\nfrom typing import Any\n\nimport numpy as np\nfrom onnxruntime import InferenceSession, SessionOptions\n\nfrom api.main import get_settings\n\n\nclass InferenceRunner:\n    def __init__(self, model_path: Path) -> None:\n        opts = SessionOptions()\n        opts.log_severity_level = 3\n        self.session = InferenceSession(str(model_path), sess_options=opts)\n\n    def predict(self, strokes: list[dict[str, Any]], seed: int) -> dict[str, Any]:\n        rng = np.random.default_rng(seed)\n        latent = self._strokes_to_tensor(strokes)\n        outputs = self.session.run(None, {\"input\": latent})\n        raw = outputs[0][0]\n        return {\n            \"element\": self._decode_element(raw),\n            \"hp\": int(np.clip(raw[1] * 500, 50, 500)),\n            \"base_attack\": int(np.clip(raw[2] * 100, 5, 100)),\n            \"seed\": seed,\n            \"explanation\": f\"deterministic-seed-{seed}\",\n            \"variance\": float(rng.random()),\n        }\n\n    def _strokes_to_tensor(self, strokes: list[dict[str, Any]]) -> np.ndarray:\n        tensor = np.zeros((1, 64, 64), dtype=np.float32)\n        for stroke in strokes:\n            x = int(stroke.get(\"x\", 0)) % 64\n            y = int(stroke.get(\"y\", 0)) % 64\n            tensor[0, y, x] = min(1.0, tensor[0, y, x] + 0.1)\n        return tensor\n\n    def _decode_element(self, raw: np.ndarray) -> str:\n        elements = [\"fire\", \"water\", \"earth\", \"air\", \"light\", \"shadow\"]\n        return elements[int(abs(raw[0]) * len(elements)) % len(elements)]\n\n\n_runner: InferenceRunner | None = None\n\n\ndef get_runner() -> InferenceRunner:\n    global _runner\n    if _runner is None:\n        model = Path(get_settings().environment).with_suffix(\".onnx\")\n        if not model.exists():\n            model = Path(\"backend/models/doodle-classifier.onnx\")\n        _runner = InferenceRunner(model)\n    return _runner\nEOF"]}
