skill card or validation error\n          content:\n            application/json:\n              schema:\n                oneOf:\n                  - $ref: '#/components/schemas/SkillCard'\n                  - $ref: '#/components/schemas/ValidationError'\n  /telemetry:\n    get:\n      summary: Fetch aggregated telemetry slices for a lobby/battle\n      parameters:\n        - in: query\n          name: lobby_id\n          schema:\n            type: string\n        - in: query\n          name: battle_id\n          schema:\n            type: string\n      responses:\n        '200':\n          description: Aggregated metrics\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/TelemetryBundle'\n  /artifacts/latest:\n    get:\n      summary: Retrieve active playable link + walkthrough video references\n      responses:\n        '200':\n          description: Demo artifact metadata\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/DemoArtifact'\ncomponents:\n  schemas:\n    Lobby:\n      type: object\n      properties:\n        id:\n          type: string\n        invite_code:\n          type: string\n        players:\n          type: array\n          items:\n            $ref: '#/components/schemas/Player'\n        status:\n          type: string\n          enum: [waiting, ready, battling, completed]\n    Player:\n      type: object\n      properties:\n        id:\n          type: string\n        display_name:\n          type: string\n        role:\n          type: string\n          enum: [player, judge, spectator]\n    Stroke:\n      type: object\n      properties:\n        x:\n          type: number\n        y:\n          type: number\n        pressure:\n          type: number\n        timestamp:\n          type: integer\n    InferenceTicket:\n      type: object\n      properties:\n        ticket_id:\n          type: string\n        exp